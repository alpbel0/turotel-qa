# Copy to .env and adjust. Values below are non-secret local-development defaults.
# Real secrets (Jev API key) go only in .env, which is gitignored.

# PostgreSQL (development)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=turotel
POSTGRES_PASSWORD=turotel_dev_password
POSTGRES_DB=turotel

# Neo4j (development)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=turotel_dev_password

# Test environment (separate keys; tests never read the development ones above).
# Postgres: same container as development, but a separate database whose name must end in _test.
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_USER=turotel
TEST_POSTGRES_PASSWORD=turotel_dev_password
TEST_POSTGRES_DB=turotel_test
TEST_POSTGRES_ADMIN_DB=postgres
# Neo4j: the separate "test" compose profile, port 7688 only.
TEST_NEO4J_URI=bolt://127.0.0.1:7688
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=turotel_test_password

# TypeSafe Jev (leave empty here; set the real key in .env)
JEV_API_KEY=
JEV_BASE_URL=
